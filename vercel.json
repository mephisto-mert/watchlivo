{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/sw\\.js",
      "dest": "/api/index.py"
    },
    {
      "src": "/manifest\\.json",
      "dest": "/static/manifest.json",
      "headers": {
        "Content-Type": "application/manifest+json; charset=utf-8"
      }
    },
    {
      "src": "/download/apk",
      "dest": "/static/Watchlivo-v1.1.apk",
      "headers": {
        "Content-Type": "application/vnd.android.package-archive",
        "Content-Disposition": "attachment; filename=\"Watchlivo-v1.1.apk\""
      }
    },
    {
      "src": "/download/(windows|exe)",
      "dest": "/static/Watchlivo.exe",
      "headers": {
        "Content-Type": "application/vnd.microsoft.portable-executable",
        "Content-Disposition": "attachment; filename=\"Watchlivo.exe\""
      }
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/healthz",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/static/index.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    }
  ]
}
